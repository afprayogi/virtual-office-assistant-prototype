# ===========================================================================
# OmniRoute AI Gateway — SATU-SATUNYA endpoint LLM yang dipakai aplikasi.
# Semua panggilan model (OpenAI/Anthropic/Gemini/Ollama) dialirkan lewat
# gateway ini; tidak ada koneksi langsung ke provider individual.
# ===========================================================================

# Base URL gateway (lokal/self-hosted, OpenAI-compatible).
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# API key gateway. Ambil dari OmniRoute (tab API Keys), BUKAN dari provider.
OMNIROUTE_API_KEY=ganti-dengan-api-key-omniroute

# Token compression: rtk (default, paling hemat) | caveman | off
OMNIROUTE_COMPRESS=rtk

# Auto-Combo Engine: auto (fallback antar provider aktif) | off
OMNIROUTE_COMBO=auto

# ============================ Server ======================================
PORT=3000
HOST=localhost

# Catatan: variabel OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY
# SENGAJA TIDAK dipakai. independen dari provider; OmniRoute yang memegang
# kredensial asli masing-masing provider.
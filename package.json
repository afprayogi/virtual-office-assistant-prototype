    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "ws": "^8.22.0",
    "zustand": "^5.0.0"

    "test": "tsx ./tests/markdown.test.ts",
    "test:orchestration": "tsx ./tests/orchestration.test.ts",
    "test:deliverables": "tsx ./tests/deliverables.test.ts",
    "test:workspace": "tsx ./tests/workspace.test.ts",
    "test:project": "tsx ./tests/project-crud.test.ts",
    "test:taskfolder": "tsx ./tests/task-folder.test.ts",
    "test:fs": "tsx ./tests/workspace.test.ts && tsx ./tests/project-crud.test.ts && tsx ./tests/task-folder.test.ts",
    "test:web": "tsx ./tests/websearch.test.ts",
    "test:pdf": "tsx ./tests/pdf-check.ts",
    "test:live": "tsx ./tests/live-deliverables.ts",
    "test:runner": "tsx ./tests/runner.test.ts",
    "test:memory": "tsx ./tests/memory.test.ts",
    "test:deps": "tsx ./tests/deps.test.ts",
    "test:tools": "tsx ./tests/tools.test.ts",
    "test:engine": "tsx ./tests/engine-smoke.ts",
    "test:e2e": "tsx ./tests/e2e-prod.ts",
    "typecheck": "tsc --noEmit",
    "docs:images": "tsx ./tools/render-docs-images.ts"
  },
